# Normalize line endings in the repository, use native ones on checkout
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.sln     text eol=crlf
*.slnx    text
*.axaml   text
*.swift   text
*.sh      text eol=lf
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

*.png     binary
*.ico     binary
*.icns    binary
