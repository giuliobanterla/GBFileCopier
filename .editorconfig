root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,axaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sln,ps1,cmd,bat}]
end_of_line = crlf

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:suggestion
dotnet_sort_system_directives_first = true
# Format strings come from the localized resources and change with the language: caching them is wrong
dotnet_diagnostic.CA1863.severity = none

# Tests: Method_Condition_Expectation names are fine
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
