<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GBFileCopier.App.ViewModels"
        x:Class="GBFileCopier.App.Views.ConflictWindow"
        x:DataType="vm:ConflictViewModel"
        Title="File already exists"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <StackPanel Margin="20" Spacing="14">
    <StackPanel Spacing="2">
      <TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock Classes="subtle" Text="{Binding Folder, StringFormat='already exists in {0}'}" TextWrapping="Wrap" />
    </StackPanel>

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
      <TextBlock Text="Existing" FontWeight="SemiBold" />
      <TextBlock Grid.Column="1" Text="{Binding ExistingDetails}" />
      <TextBlock Grid.Row="1" Text="New" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NewDetails}" />
      <TextBlock Grid.Row="2" Grid.Column="1" Classes="subtle" Text="{Binding Comparison}" />
    </Grid>

    <CheckBox Content="Do the same for the next conflicts" IsChecked="{Binding ApplyToAll}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Keep both" Command="{Binding KeepBothCommand}"
              ToolTip.Tip="Save the new file as &quot;name (2)&quot;" />
      <Button Content="Skip" Command="{Binding SkipCommand}" IsCancel="True" />
      <Button Classes="accent" Content="Replace" Command="{Binding OverwriteCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
