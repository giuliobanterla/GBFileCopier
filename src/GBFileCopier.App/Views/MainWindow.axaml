<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GBFileCopier.App.ViewModels"
        xmlns:res="using:GBFileCopier.App.Resources"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="760"
        x:Class="GBFileCopier.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.ico"
        Title="{Binding Title}"
        Width="820" Height="760" MinWidth="600" MinHeight="560">

  <DockPanel>
  <!-- The menu bar inside the window on Windows and Linux; on macOS the menu is in the system menu bar -->
  <NativeMenuBar DockPanel.Dock="Top" />

  <!-- Update bar: asks about automatic checks, announces a new version, shows the download -->
  <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="16,10"
          IsVisible="{Binding Updates.IsVisible, FallbackValue=False}">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
      <TextBlock Text="{Binding Updates.Message, FallbackValue=''}" TextWrapping="Wrap" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="accent" Content="{x:Static res:Strings.UpdateYes}" Command="{Binding Updates.EnableAutomaticCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding Updates.IsAsking, FallbackValue=False}" />
        <Button Content="{x:Static res:Strings.UpdateNo}" Command="{Binding Updates.DisableAutomaticCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding Updates.IsAsking, FallbackValue=False}" />
        <Button Content="{x:Static res:Strings.UpdateWhatsNew}" Command="{Binding Updates.WhatsNewCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding Updates.IsAvailable, FallbackValue=False}" />
        <Button Classes="accent" Content="{Binding Updates.InstallLabel, FallbackValue=''}" Command="{Binding Updates.InstallCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding Updates.IsAvailable, FallbackValue=False}" />
        <Button Content="{x:Static res:Strings.UpdateLater}" Command="{Binding Updates.DismissCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding Updates.IsAvailable, FallbackValue=False}" />
        <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding Updates.CancelDownloadCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding Updates.IsDownloading, FallbackValue=False}" />
        <Button Content="{x:Static res:Strings.Close}" Command="{Binding Updates.DismissCommand, FallbackValue={x:Null}}"
                IsVisible="{Binding Updates.CanClose, FallbackValue=False}" />
      </StackPanel>
      <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Updates.ProgressPercent, FallbackValue=0}" Maximum="100"
                   IsVisible="{Binding Updates.IsDownloading, FallbackValue=False}" />
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="subtle" Text="{x:Static res:Strings.UpdateWaitForJobs}"
                 IsVisible="{Binding Updates.WaitsForJobs, FallbackValue=False}" />
    </Grid>
  </Border>

  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="16" RowSpacing="12">

    <!-- Sources toolbar -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <TextBlock Classes="section" Text="{x:Static res:Strings.FilesAndFolders}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <Button Content="{x:Static res:Strings.AddFiles}" Command="{Binding AddFilesCommand}" />
        <Button Content="{x:Static res:Strings.AddFolder}" Command="{Binding AddFolderCommand}" />
        <Button Content="{x:Static res:Strings.Paste}" Command="{Binding PasteCommand}" CommandParameter="{x:False}"
                ToolTip.Tip="{x:Static res:Strings.PasteTip}" />
        <Button Content="{x:Static res:Strings.Remove}" Command="{Binding RemoveSelectedCommand}" />
        <Button Content="{x:Static res:Strings.Clear}" Command="{Binding ClearSourcesCommand}" />
      </StackPanel>
    </Grid>

    <!-- Sources list, also a drop target -->
    <Border Grid.Row="1" x:Name="SourcesDropArea" DragDrop.AllowDrop="True"
            Background="{DynamicResource DropBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1" CornerRadius="6">
      <Panel>
        <ListBox x:Name="SourcesList" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                 Background="Transparent" IsVisible="{Binding HasSources}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SourceItem">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <PathIcon Width="16" Height="16" Data="{StaticResource FolderIcon}" IsVisible="{Binding IsFolder}" />
                <PathIcon Width="16" Height="16" Data="{StaticResource FileIcon}" IsVisible="{Binding !IsFolder}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="subtle" Text="{Binding Folder}" TextTrimming="PathSegmentEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Classes="subtle" Text="{Binding Details}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel IsVisible="{Binding !HasSources}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
          <PathIcon Width="40" Height="40" Data="{StaticResource FolderIcon}" Foreground="{DynamicResource SubtleTextBrush}" />
          <TextBlock Text="{x:Static res:Strings.DropHere}" HorizontalAlignment="Center" FontSize="15" />
          <TextBlock Classes="subtle" HorizontalAlignment="Center"
                     Text="{x:Static res:Strings.DropHint}" />
        </StackPanel>
      </Panel>
    </Border>

    <!-- Destination and options -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="10">
      <TextBlock Classes="section" Text="{x:Static res:Strings.Destination}" />
      <TextBox Grid.Column="1" x:Name="DestinationBox" DragDrop.AllowDrop="True" Text="{Binding Destination}"
               PlaceholderText="{x:Static res:Strings.DestinationPlaceholder}" />
      <Button Grid.Column="2" Content="{x:Static res:Strings.Browse}" Command="{Binding BrowseDestinationCommand}" />

      <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemSpacing="16" LineSpacing="8">
        <CheckBox Content="{x:Static res:Strings.VerifyAfterCopying}" IsChecked="{Binding Verify}"
                  ToolTip.Tip="{x:Static res:Strings.VerifyTip}" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{x:Static res:Strings.Checksum}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding HashOptions}" SelectedItem="{Binding SelectedHash}" MinWidth="150">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:HashOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{x:Static res:Strings.IfFileExists}" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding ConflictOptions}" SelectedItem="{Binding SelectedConflict}" MinWidth="150">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ConflictOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </WrapPanel>
    </Grid>

    <!-- Actions: each Copy or Move becomes a job; the list is then ready for the next one -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Classes="subtle" Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="primary" Content="{x:Static res:Strings.Move}" Command="{Binding MoveCommand}"
                IsDefault="{Binding PreferMove}" Classes.accent="{Binding PreferMove}" />
        <Button Classes="primary" Content="{x:Static res:Strings.Copy}" Command="{Binding CopyCommand}"
                IsDefault="{Binding !PreferMove}" Classes.accent="{Binding !PreferMove}" />
      </StackPanel>
    </Grid>

    <!-- Jobs: one at a time per destination drive, different drives at the same time -->
    <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="6" IsVisible="{Binding HasJobs}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="section" Text="{x:Static res:Strings.Jobs}" />
        <Button Grid.Column="1" Content="{x:Static res:Strings.ClearFinished}" Command="{Binding ClearFinishedCommand}" />
      </Grid>
      <ListBox Grid.Row="1" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" MaxHeight="215"
               Background="{DynamicResource PanelBrush}" CornerRadius="6">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:JobViewModel">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="PathSegmentEllipsis"
                           ToolTip.Tip="{Binding Title}" />
                <TextBlock Grid.Column="1" Classes="subtle" Text="{Binding ItemsText}" VerticalAlignment="Center" />
              </Grid>
              <ProgressBar Grid.Row="1" Value="{Binding ProgressPercent}" Maximum="100" IsVisible="{Binding !IsWaiting}" />
              <!-- The file name can be long and is shortened; files, speed and time left never are -->
              <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Classes="subtle" Text="{Binding StatusLine}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusLine}" />
                <TextBlock Grid.Column="1" Classes="subtle" Text="{Binding FilesText}" IsVisible="{Binding IsRunning}" />
              </Grid>
              <TextBlock Grid.Row="3" Text="{Binding TransferText}" FontWeight="SemiBold" IsVisible="{Binding IsRunning}" />
              <StackPanel Grid.Column="1" Grid.RowSpan="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{Binding PauseLabel}" Command="{Binding TogglePauseCommand}" IsVisible="{Binding IsRunning}" />
                <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsActive}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- Files of the selected job: queued, being copied, done; where each one goes -->
    <Grid Grid.Row="5" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" IsVisible="{Binding SelectedJob.HasFiles, FallbackValue=False}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <TextBlock Classes="section" Text="{x:Static res:Strings.JobFiles}" />
        <TextBlock Grid.Column="1" Classes="subtle" Text="{Binding SelectedJob.Title, FallbackValue=''}"
                   TextTrimming="PathSegmentEllipsis" VerticalAlignment="Center" />
        <ComboBox Grid.Column="2" ItemsSource="{Binding SelectedJob.FilterOptions, FallbackValue={x:Null}}"
                  SelectedItem="{Binding SelectedJob.SelectedFilter, FallbackValue={x:Null}}" MinWidth="130">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:JobFileFilterOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
      <TextBlock Grid.Row="1" Classes="subtle" Text="{Binding SelectedJob.FilesSummary, FallbackValue=''}" />
      <ListBox Grid.Row="2" ItemsSource="{Binding SelectedJob.Files, FallbackValue={x:Null}}" Height="170">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:JobFileItem">
            <!-- Name on the first line; where it goes (later the error or the checksum) on the second -->
            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto" ColumnSpacing="10">
              <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                         Classes.status-failed="{Binding IsFailed}" Classes.status-warning="{Binding IsWarning}"
                         Classes.status-ok="{Binding IsOk}" Classes.subtle="{Binding !IsDone}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourcePath}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="subtle" Text="{Binding Message}" TextTrimming="PathSegmentEllipsis"
                         ToolTip.Tip="{Binding Message}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
  </DockPanel>
</Window>
