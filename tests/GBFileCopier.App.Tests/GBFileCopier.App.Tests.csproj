  <ItemGroup>
    <Compile Include="..\GBFileCopier.Core.Tests\TempDirectory.cs" Link="TempDirectory.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GBFileCopier.App\GBFileCopier.App.csproj" />
  </ItemGroup>

</Project>
